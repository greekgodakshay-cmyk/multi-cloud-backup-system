# ==============================================================================
# Multi-Cloud Backup System — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual settings if using cloud storage.
# For local offline mode, NO credentials are required.
# NEVER commit your actual '.env' file to source control.

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Storage Mode Selection
# Options:
#   - 'local' (DEFAULT: uses isolated local filesystem directories; 100% free, no credit card)
#   - 'cloud' (uses actual Cloudflare R2 / AWS S3 / Backblaze B2 credentials below)
# ------------------------------------------------------------------------------
STORAGE_MODE=local

# ------------------------------------------------------------------------------
# Local Storage Mode Configuration (Used when STORAGE_MODE=local)
# ------------------------------------------------------------------------------
LOCAL_PRIMARY_DIR=./data/primary
LOCAL_SECONDARY_DIR=./data/secondary
ENABLE_LOCAL_SECONDARY=true

# ------------------------------------------------------------------------------
# Primary Storage: Cloudflare R2 (S3-Compatible Protocol)
# Required only if STORAGE_MODE=cloud and using R2 as Primary
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=multi-cloud-primary-backup
# Optional custom endpoint (default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# Secondary Storage: Backblaze B2 (S3-Compatible Protocol)
# Required only if STORAGE_MODE=cloud and using B2 as Secondary
# Standard BACKBLAZE_* variables (B2_* aliases also supported)
# ------------------------------------------------------------------------------
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_BUCKET_ID=
BACKBLAZE_REGION=us-east-005
BACKBLAZE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKBLAZE_FORCE_PATH_STYLE=false

# Legacy aliases (supported for backward compatibility)
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_REGION=us-east-005
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# ------------------------------------------------------------------------------
# Alternative: Standard AWS S3 (Optional)
# Can be used as Primary or Secondary target with official AWS credentials
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT=

# ------------------------------------------------------------------------------
# Operational Safety Guardrails
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=52428800 # 50 MB Free-Tier Safety Cap
PRESIGNED_URL_TTL_SECONDS=900 # 15 minutes
